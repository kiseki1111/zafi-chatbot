generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

//membuat model user
model User {
  id         String    @id @default(uuid()) // Diubah ke UUID sesuai TDD Halaman 4
  name       String?   @db.VarChar(100) // VARCHAR(100) Nullable sesuai TDD Halaman 4
  email      String    @unique @db.VarChar(150) // VARCHAR(150) sesuai TDD Halaman 4
  password   String    @db.VarChar(255) // VARCHAR(255) sesuai TDD Halaman 4
  isActive   Boolean   @default(true) @map("is_active") // Ditambahkan sesuai TDD Halaman 4
  lastLogin  DateTime? @map("last_login") // Ditambahkan sesuai TDD Halaman 4
  divisionId String?   @map("division_id") // Relasi ke divisi
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  division      Division?                @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  conversations Conversation[]
  messages      Message[]
  assignments   ConversationAssignment[]
  notes         Note[]
  bookings      Booking[]

  @@map("users")
}

model Division {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users           User[]
  channelAccounts ChannelAccount[]

  @@map("divisions")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(50) // VARCHAR(50) sesuai TDD Halaman 4
  description String?
  createdAt   DateTime @default(now()) @map("created_at") // Ditambahkan @map sesuai TDD Halaman 6
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") // Ditambahkan @map sesuai TDD Halaman 6

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100) // VARCHAR(100) sesuai TDD Halaman 4
  resource    String   @db.VarChar(50) // VARCHAR(50) sesuai TDD Halaman 4
  action      String   @db.VarChar(50) // VARCHAR(50) sesuai TDD Halaman 4
  description String?
  createdAt   DateTime @default(now()) @map("created_at") // Ditambahkan @map sesuai TDD Halaman 6
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") // Ditambahkan @map sesuai TDD Halaman 6

  roles RolePermission[]

  @@unique([resource, action]) //untuk mencegah duplikasi
  @@map("permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at") // @map ditambahkan

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles") //membuat nama tabel/variable agar tidak clash
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  assignedAt   DateTime @default(now()) @map("assigned_at") // @map ditambahkan

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade) //mendaftarkan foreign key
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId]) //memastikan agar data yang dibuat tetap distinct
  @@map("role_permissions")
}

model RefreshToken {
  id        String   @id @default(uuid()) // Diubah ke UUID sesuai TDD Halaman 5
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash") // NAMA RESMI DOKUMEN
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid()) // Diubah ke UUID sesuai TDD Halaman 5
  userId    String?  @map("user_id")
  action    String   @db.VarChar(100) // VARCHAR(100) sesuai TDD Halaman 5
  module    String   @db.VarChar(50) // VARCHAR(50) sesuai TDD Halaman 5
  endpoint  String
  ipAddress String?  @map("ip_address") @db.VarChar(45) // VARCHAR(45) sesuai TDD Halaman 5
  userAgent String?  @map("user_agent")
  status    String // Tetap dipertahankan karena dipakai implementasi
  details   Json? // Tetap dipertahankan karena dipakai implementasi
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model ChannelAccount {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String?  @db.Text
  platform    String   @default("WHATSAPP") @db.VarChar(50)
  isActive    Boolean  @default(true) @map("is_active")
  divisionId  String?  @map("division_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  division          Division?          @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  whatsappInstances WhatsappInstance[]

  @@map("channel_accounts")
}

model WhatsappInstance {
  id               String  @id @default(uuid())
  channelAccountId String? @map("channel_account_id")
  instanceName     String  @unique @map("instance_name")
  phone            String? @db.VarChar(50)
  profileName      String? @map("profile_name") @db.VarChar(100)
  profilePicture   String? @map("profile_picture") @db.Text
  status           String  @default("STOPPED") @db.VarChar(50)
  qrCode           String? @map("qr_code") @db.Text

  provider   String  @default("WAHA") @db.VarChar(50)
  webhookUrl String? @map("webhook_url") @db.Text

  messagesSent     Int       @default(0) @map("messages_sent")
  messagesReceived Int       @default(0) @map("messages_received")
  messagesFailed   Int       @default(0) @map("messages_failed")
  lastConnectedAt  DateTime? @map("last_connected_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  channelAccount ChannelAccount?   @relation(fields: [channelAccountId], references: [id], onDelete: SetNull)
  sessions       WhatsappSession[]
  webhookLogs    WebhookLog[]
  conversations  Conversation[]

  @@map("whatsapp_instances")
}

model WhatsappSession {
  id             String    @id @default(uuid())
  instanceId     String    @map("instance_id")
  sessionData    Json?     @map("session_data")
  devicePlatform String?   @map("device_platform") @db.VarChar(50)
  disconnectedAt DateTime? @map("disconnected_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  instance WhatsappInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("whatsapp_sessions")
}

model WebhookLog {
  id           String   @id @default(uuid())
  instanceName String   @map("instance_name")
  event        String   @db.VarChar(50)
  payload      Json
  createdAt    DateTime @default(now()) @map("created_at")

  instance WhatsappInstance @relation(fields: [instanceName], references: [instanceName], onDelete: Cascade)

  @@map("webhook_logs")
}

// --- MARKETING & CRM NEW MODELS ---

model Contact {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  phone     String   @unique @db.VarChar(50)
  email     String?  @db.VarChar(150)
  status    String   @default("NEW") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tags          ContactTag[]
  conversations Conversation[]
  bookings      Booking[]

  @@map("contacts")
}

model Conversation {
  id            String   @id @default(uuid())
  contactId     String   @map("contact_id")
  instanceName  String   @map("instance_name")
  unreadCount   Int      @default(0) @map("unread_count")
  status        String   @default("OPEN")
  assignedToId  String?  @map("assigned_to_id")
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")

  contact          Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  whatsappInstance WhatsappInstance @relation(fields: [instanceName], references: [instanceName], onDelete: Cascade)
  assignedTo       User?            @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  messages    Message[]
  assignments ConversationAssignment[]
  aiSessions  AiSession[]
  notes       Note[]

  @@unique([instanceName, contactId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  wahaMessageId  String?  @unique @map("waha_message_id")
  conversationId String   @map("conversation_id")
  senderType     String   @map("sender_type")
  senderId       String?  @map("sender_id")
  messageType    String   @default("TEXT") @map("message_type")
  content        String   @db.Text
  metadata       Json?
  status         String   @default("SENT")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?               @relation(fields: [senderId], references: [id], onDelete: SetNull)
  attachments  MessageAttachment[]
  aiMessages   AiMessage[]

  @@map("messages")
}

model MessageAttachment {
  id        String @id @default(uuid())
  messageId String @map("message_id")
  fileUrl   String @map("file_url")
  mimeType  String @map("mime_type")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

model ConversationAssignment {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  agentId        String   @map("agent_id")
  assignedAt     DateTime @default(now()) @map("assigned_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        User         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("conversation_assignments")
}

model AiSession {
  id             String  @id @default(uuid())
  conversationId String  @map("conversation_id")
  summary        String? @db.Text
  tokenUsage     Int     @default(0) @map("token_usage")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_sessions")
}

model AiMessage {
  id        String @id @default(uuid())
  messageId String @map("message_id")
  prompt    String @db.Text
  response  String @db.Text
  model     String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}

model Tag {
  id   String @id @default(uuid())
  name String @unique @db.VarChar(50)

  contacts ContactTag[]

  @@map("tags")
}

model ContactTag {
  contactId String @map("contact_id")
  tagId     String @map("tag_id")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@map("contact_tags")
}

model Label {
  id    String @id @default(uuid())
  name  String @unique @db.VarChar(50)
  color String @db.VarChar(20)

  @@map("labels")
}

model Note {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  agentId        String   @map("agent_id")
  note           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        User         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("notes")
}

model Broadcast {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(150)
  content   String   @db.Text
  status    String   @default("DRAFT") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("broadcasts")
}

// --- MASTER DATA LISTING ---
model Project {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  location    String   @db.VarChar(200)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  units Unit[]

  @@map("projects")
}

model Unit {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  unitCode  String   @db.VarChar(50)
  type      String   @db.VarChar(50) // e.g., "Tipe 36", "Tipe 45"
  price     Decimal  @db.Decimal(15, 2)
  status    String   @default("AVAILABLE") // AVAILABLE, RESERVED, SOLD
  createdAt DateTime @default(now()) @map("created_at")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("units")
}

// --- TRANSAKSI & KPR ---
model Booking {
  id          String @id @default(uuid())
  bookingCode String @unique @db.VarChar(50)
  contactId   String @map("contact_id")
  unitId      String @map("unit_id")
  agentId     String @map("agent_id")

  totalDp     Decimal  @map("total_dp") @db.Decimal(15, 2)
  paidDp      Decimal  @default(0) @map("paid_dp") @db.Decimal(15, 2)
  status      String   @default("PENDING") // PENDING, PARTIAL, COMPLETED, CANCELLED
  bookingDate DateTime @default(now()) @map("booking_date")

  contact Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  unit    Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  agent   User           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  kpr     KprSubmission?

  @@map("bookings")
}

model KprSubmission {
  id          String    @id @default(uuid())
  bookingId   String    @unique @map("booking_id")
  bankName    String    @map("bank_name") @db.VarChar(100)
  status      String    @default("BERKAS_BELUM_LENGKAP") // BERKAS_BELUM_LENGKAP, BI_CHECKING, PROSES_BANK, APPROVED, REJECTED
  submittedAt DateTime? @map("submitted_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("kpr_submissions")
}

// --- RAG & KNOWLEDGE BASE ---
model KnowledgeBase {
  id        String                       @id @default(uuid())
  content   String                       @db.Text
  embedding Unsupported("vector(1536)")?
  metadata  Json?
  createdAt DateTime                     @default(now()) @map("created_at")
  updatedAt DateTime                     @updatedAt @map("updated_at")

  @@map("knowledge_base")
}

model Property {
  id String @id @default(uuid())

  name     String
  location String
  type     String

  cashPrice Float
  adminFee  Float?
  dp        Float?

  landArea    String
  electricity String
  bedrooms    Int
  bathrooms   Int

  specifications  String @db.Text
  facilities      String @db.Text
  installmentInfo String @db.Text

  imageUrl    String?
  layoutDenah String? @db.Text

  embeddingText String?                      @db.Text
  embedding     Unsupported("vector(1536)")?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("properties")
}
