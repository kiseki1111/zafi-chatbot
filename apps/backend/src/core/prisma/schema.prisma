generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

//membuat model user
model User {
  id        String    @id @default(uuid()) // Diubah ke UUID sesuai TDD Halaman 4
  name      String?   @db.VarChar(100) // VARCHAR(100) Nullable sesuai TDD Halaman 4
  email     String    @unique @db.VarChar(150) // VARCHAR(150) sesuai TDD Halaman 4
  password  String    @db.VarChar(255) // VARCHAR(255) sesuai TDD Halaman 4
  isActive  Boolean   @default(true) @map("is_active") // Ditambahkan sesuai TDD Halaman 4
  lastLogin DateTime? @map("last_login") // Ditambahkan sesuai TDD Halaman 4
  role      String    @default("USER") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenantId String? @unique @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  conversations Conversation[]
  messages      Message[]
  assignments   ConversationAssignment[]
  notes         Note[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) // Diubah ke UUID sesuai TDD Halaman 5
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash") // NAMA RESMI DOKUMEN
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid()) // Diubah ke UUID sesuai TDD Halaman 5
  userId    String?  @map("user_id")
  action    String   @db.VarChar(100) // VARCHAR(100) sesuai TDD Halaman 5
  module    String   @db.VarChar(50) // VARCHAR(50) sesuai TDD Halaman 5
  endpoint  String
  ipAddress String?  @map("ip_address") @db.VarChar(45) // VARCHAR(45) sesuai TDD Halaman 5
  userAgent String?  @map("user_agent")
  status    String // Tetap dipertahankan karena dipakai implementasi
  details   Json? // Tetap dipertahankan karena dipakai implementasi
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model ChannelAccount {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String?  @db.Text
  platform    String   @default("WHATSAPP") @db.VarChar(50)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  whatsappInstances WhatsappInstance[]

  @@map("channel_accounts")
}

model WhatsappInstance {
  id               String  @id @default(uuid())
  channelAccountId String? @map("channel_account_id")
  instanceName     String  @unique @map("instance_name")
  phone            String? @db.VarChar(50)
  profileName      String? @map("profile_name") @db.VarChar(100)
  profilePicture   String? @map("profile_picture") @db.Text
  status           String  @default("STOPPED") @db.VarChar(50)
  qrCode           String? @map("qr_code") @db.Text

  provider   String  @default("WAHA") @db.VarChar(50)
  webhookUrl String? @map("webhook_url") @db.Text

  messagesSent     Int       @default(0) @map("messages_sent")
  messagesReceived Int       @default(0) @map("messages_received")
  messagesFailed   Int       @default(0) @map("messages_failed")
  lastConnectedAt  DateTime? @map("last_connected_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  channelAccount ChannelAccount?   @relation(fields: [channelAccountId], references: [id], onDelete: SetNull)
  sessions       WhatsappSession[]
  webhookLogs    WebhookLog[]
  conversations  Conversation[]

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_instances")
}

model WhatsappSession {
  id             String    @id @default(uuid())
  instanceId     String    @map("instance_id")
  sessionData    Json?     @map("session_data")
  devicePlatform String?   @map("device_platform") @db.VarChar(50)
  disconnectedAt DateTime? @map("disconnected_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  instance WhatsappInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("whatsapp_sessions")
}

model WebhookLog {
  id           String   @id @default(uuid())
  instanceName String   @map("instance_name")
  event        String   @db.VarChar(50)
  payload      Json
  createdAt    DateTime @default(now()) @map("created_at")

  instance WhatsappInstance @relation(fields: [instanceName], references: [instanceName], onDelete: Cascade)

  @@map("webhook_logs")
}

// --- MARKETING & CRM NEW MODELS ---

model Contact {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  phone     String   @unique @db.VarChar(50)
  email     String?  @db.VarChar(150)
  status    String   @default("NEW") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tags          ContactTag[]
  conversations Conversation[]
  followUps     FollowUp[]

  @@map("contacts")
}

model FollowUp {
  id           String   @id @default(uuid())
  contactId    String   @map("contact_id")
  instanceName String   @map("instance_name")
  followedUpAt DateTime @default(now()) @map("followed_up_at")
  createdAt    DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, instanceName])
  @@map("follow_ups")
}

model FollowUpConfig {
  id              String   @id @default(uuid())
  tenantId        String   @unique @map("tenant_id")
  isEnabled       Boolean  @default(false) @map("is_enabled")
  scheduleTime    String   @default("09:00") @map("schedule_time")
  inactivityHours Int      @default(24) @map("inactivity_hours")
  followUpPrompt  String?  @map("follow_up_prompt")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("follow_up_configs")
}

model Conversation {
  id            String   @id @default(uuid())
  contactId     String   @map("contact_id")
  instanceName  String   @map("instance_name")
  unreadCount   Int      @default(0) @map("unread_count")
  status        String   @default("OPEN")
  assignedToId  String?  @map("assigned_to_id")
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")

  contact          Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  whatsappInstance WhatsappInstance @relation(fields: [instanceName], references: [instanceName], onDelete: Cascade)
  assignedTo       User?            @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  messages    Message[]
  assignments ConversationAssignment[]
  aiSessions  AiSession[]
  notes       Note[]

  @@unique([instanceName, contactId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  wahaMessageId  String?  @unique @map("waha_message_id")
  conversationId String   @map("conversation_id")
  senderType     String   @map("sender_type")
  senderId       String?  @map("sender_id")
  messageType    String   @default("TEXT") @map("message_type")
  content        String   @db.Text
  metadata       Json?
  status         String   @default("SENT")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?               @relation(fields: [senderId], references: [id], onDelete: SetNull)
  attachments  MessageAttachment[]
  aiMessages   AiMessage[]

  @@map("messages")
}

model MessageAttachment {
  id        String @id @default(uuid())
  messageId String @map("message_id")
  fileUrl   String @map("file_url")
  mimeType  String @map("mime_type")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

model ConversationAssignment {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  agentId        String   @map("agent_id")
  assignedAt     DateTime @default(now()) @map("assigned_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        User         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("conversation_assignments")
}

model AiSession {
  id             String  @id @default(uuid())
  conversationId String  @map("conversation_id")
  summary        String? @db.Text
  tokenUsage     Int     @default(0) @map("token_usage")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_sessions")
}

model AiMessage {
  id        String @id @default(uuid())
  messageId String @map("message_id")
  prompt    String @db.Text
  response  String @db.Text
  model     String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}

model Tag {
  id   String @id @default(uuid())
  name String @unique @db.VarChar(50)

  contacts ContactTag[]

  @@map("tags")
}

model ContactTag {
  contactId String @map("contact_id")
  tagId     String @map("tag_id")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@map("contact_tags")
}

model Label {
  id    String @id @default(uuid())
  name  String @unique @db.VarChar(50)
  color String @db.VarChar(20)

  @@map("labels")
}

model Note {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  agentId        String   @map("agent_id")
  note           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        User         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("notes")
}

model Broadcast {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(150)
  content   String   @db.Text
  status    String   @default("DRAFT") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("broadcasts")
}

// --- MASTER DATA LISTING (UMKM) ---
model Product {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(100)
  description String  @db.Text
  price       Decimal @db.Decimal(15, 2)
  stock       Int     @default(0)
  category    String  @db.VarChar(50)
  imageUrl    String? @db.Text
  attributes  Json?   @default("{}")

  // Untuk keperluan RAG (CS Agent)
  embeddingText String?                      @db.Text
  embedding     Unsupported("vector(4096)")?

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  salesRecords SalesRecord[]

  @@map("products")
}

// --- DATA & LAPORAN ---
model SalesRecord {
  id            String  @id @default(uuid())
  receiptNumber String  @unique @map("receipt_number") @db.VarChar(100)
  tenantId      String  @map("tenant_id")
  productId     String? @map("product_id")
  quantity      Int     @default(1)
  totalPrice    Decimal @db.Decimal(15, 2)

  customerName String? @map("customer_name") @db.VarChar(150)
  notes        String? @db.Text
  attributes   Json?   @default("{}")
  metadata     Json?   @default("{}")

  source     String  @default("BOT_AI")
  reportedBy String? @db.VarChar(50) // Chat ID atau Nomor WA Owner

  soldAt    DateTime @default(now()) @map("sold_at")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("sales_records")
}

// --- RAG & KNOWLEDGE BASE ---
model KnowledgeBase {
  id        String                       @id @default(uuid())
  content   String                       @db.Text
  embedding Unsupported("vector(4096)")?
  metadata  Json?
  tenantId  String?                      @map("tenant_id")
  tenant    Tenant?                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime                     @default(now()) @map("created_at")
  updatedAt DateTime                     @updatedAt @map("updated_at")

  @@map("knowledge_base")
}

model VectorKnowledge {
  id        String                       @id @default(uuid())
  title     String                       @db.VarChar(255)
  content   String                       @db.Text
  metadata  Json?                        @default("{}")
  embedding Unsupported("vector(4096)")?
  tenantId  String?                      @map("tenant_id")
  tenant    Tenant?                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime                     @default(now()) @map("created_at")
  updatedAt DateTime                     @updatedAt @map("updated_at")

  @@map("vector_knowledge")
}

model Tenant {
  id              String  @id @default(uuid())
  name            String  @db.VarChar(150)
  category        String? @db.VarChar(100)
  description     String? @db.Text
  address         String? @db.Text
  phone           String? @db.VarChar(50)
  operatingHours  String? @db.VarChar(200)
  socialLinks     Json?
  paymentMethods  String? @db.Text
  shippingMethods String? @db.Text
  returnPolicy    String? @db.Text
  currentPromo    String? @db.Text
  extraInfo       String? @db.Text
  metadata        Json?   @default("{}")

  agentName   String  @default("Luna") @db.VarChar(50)
  agentTone   String  @default("friendly") @db.VarChar(100)
  greetingMsg String? @db.Text
  systemPrompt String? @db.Text

  ownerChatId String? @map("owner_chat_id") @db.VarChar(100) // Nomor WA / Telegram ID si Bos
  closingTime String  @default("21:00") @db.VarChar(10) // Jam berapa bot harus nagih laporan

  isOnboarded Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user              User?
  products          Product[]
  knowledgeBases    KnowledgeBase[]
  vectorKnowledge   VectorKnowledge[]
  salesRecords      SalesRecord[]
  onboardingSession OnboardingSession?
  whatsappInstances WhatsappInstance[]
  resourceGroups    ResourceGroup[]
  followUpConfig    FollowUpConfig?

  @@map("tenants")
}

model ResourceGroup {
  id            String         @id @default(uuid())
  tenantId      String?        @map("tenant_id")
  name          String         @db.VarChar(150)
  category      String         @default("properti") @db.VarChar(50)
  description   String?        @db.Text
  siteplanImage String?        @map("siteplan_image") @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  tenant Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  ResourceItem[]

  @@map("resource_groups")
}

model ResourceItem {
  id            String        @id @default(uuid())
  groupId       String        @map("group_id")
  code          String        @db.VarChar(50)
  name          String?       @db.VarChar(100)
  houseType     String?       @map("house_type") @db.VarChar(50) // Tipe rumah: "36/72", "45/90", dll
  status        String        @default("AVAILABLE") @db.VarChar(20) // AVAILABLE, BOOKED, OCCUPIED, MAINTENANCE
  capacity      Int?          @default(1)
  price         Decimal?      @db.Decimal(15, 2)
  notes         String?       @db.Text
  customerName  String?       @map("customer_name") @db.VarChar(100)
  customerPhone String?       @map("customer_phone") @db.VarChar(50)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  group ResourceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, code])
  @@map("resource_items")
}

model OnboardingSession {
  id        String   @id @default(uuid())
  tenantId  String?  @unique @map("tenant_id")
  chatId    String   @unique @map("chat_id")
  platform  String   @default("TELEGRAM") @db.VarChar(20)
  state     String   @default("SECTION_A") @db.VarChar(50)
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("onboarding_sessions")
}

// --- DESIGN BOT (telegram-ai-bot merged) ---

model DesignSession {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  step       String   @default("prompting") @db.VarChar(50)
  data       Json     @default("{}")
  lastActive DateTime @default(now()) @map("last_active")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("design_sessions")
}

model DesignGeneration {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  prompt     String?  @db.Text
  imageUrl   String?  @map("image_url") @db.Text
  designType String?  @map("design_type") @db.VarChar(50)
  status     String   @default("success") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("design_generations")
}
