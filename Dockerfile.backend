# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS deps

WORKDIR /workspace

ENV NODE_ENV=development

COPY package*.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/web/package.json apps/web/package.json

# Workaround for npm optional dependency bug in monorepo
RUN --mount=type=cache,target=/root/.npm \
    rm -f package-lock.json && npm install --include=dev --legacy-peer-deps

#########################################################

FROM deps AS builder

WORKDIR /workspace

ENV NODE_ENV=development

COPY . .

RUN npm run prisma:generate -w rbac-service
RUN if [ -d "/workspace/apps/backend/node_modules/.prisma" ]; then \
      mkdir -p /workspace/node_modules/.prisma && \
      cp -r /workspace/apps/backend/node_modules/.prisma/* /workspace/node_modules/.prisma/ && \
      mkdir -p /workspace/node_modules/@prisma/client && \
      cp -r /workspace/apps/backend/node_modules/@prisma/client/* /workspace/node_modules/@prisma/client/; \
    fi
RUN if [ -d "/workspace/node_modules/.prisma" ]; then \
      mkdir -p /workspace/apps/backend/node_modules/.prisma && \
      cp -r /workspace/node_modules/.prisma/* /workspace/apps/backend/node_modules/.prisma/ && \
      mkdir -p /workspace/apps/backend/node_modules/@prisma/client && \
      cp -r /workspace/node_modules/@prisma/client/* /workspace/apps/backend/node_modules/@prisma/client/; \
    fi
RUN npm run build -w rbac-service
RUN mkdir -p /workspace/apps/backend/node_modules

#########################################################

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Install necessary OS libraries for sharp, prisma, ffmpeg + CA certificates
RUN apk add --no-cache openssl libc6-compat ca-certificates ffmpeg tzdata && update-ca-certificates

RUN date -u +"%Y-%m-%d %H:%M:%S UTC" > /app/build_info.txt

COPY --from=builder /workspace/node_modules ./node_modules
COPY --from=builder /workspace/apps/backend/node_modules ./apps/backend/node_modules
COPY --from=builder /workspace/apps/backend/dist ./dist
COPY --from=builder /workspace/apps/backend/package.json ./package.json
COPY --from=builder /workspace/apps/backend/src/core/prisma ./src/core/prisma
COPY --from=builder /workspace/apps/backend/scripts ./scripts

RUN chmod +x ./scripts/*.sh 2>/dev/null || true

EXPOSE 3030

CMD ["/bin/sh", "scripts/docker-entrypoint.sh"]
