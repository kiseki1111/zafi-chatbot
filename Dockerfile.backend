# syntax=docker/dockerfile:1.7

############################
# Dependencies
############################
FROM node:22-alpine AS deps

WORKDIR /workspace

COPY package*.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/web/package.json apps/web/package.json

RUN --mount=type=cache,target=/root/.npm \
    npm ci

############################
# Builder
############################
FROM deps AS builder

WORKDIR /workspace

COPY . .

RUN npm run prisma:generate -w rbac-service
RUN npm run build -w rbac-service

RUN echo "===== ROOT ====="
RUN ls -lah /workspace/node_modules

RUN echo "===== BACKEND ====="
RUN ls -lah /workspace/apps/backend/node_modules || true

RUN echo "===== NEST ====="
RUN ls -lah /workspace/apps/backend/node_modules/@nestjs || true

####################################################
# DEBUG SEBELUM PRUNE
####################################################
RUN echo "===== BEFORE PRUNE ====="

RUN ls -lah node_modules

RUN ls -lah node_modules/@nestjs || true

RUN npm ls @nestjs/core || true

####################################################
# PRUNE
####################################################
RUN npm prune --omit=dev

####################################################
# DEBUG SESUDAH PRUNE
####################################################
RUN echo "===== AFTER PRUNE ====="

RUN ls -lah node_modules

RUN ls -lah node_modules/@nestjs || true

RUN npm ls @nestjs/core || true

############################
# Runner
############################
FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production

RUN apk add --no-cache openssl

COPY --from=builder /workspace/node_modules ./node_modules

COPY --from=builder /workspace/apps/backend/dist ./dist
COPY --from=builder /workspace/apps/backend/public ./public
COPY --from=builder /workspace/apps/backend/src/infrastructure/prisma ./src/infrastructure/prisma

EXPOSE 3030

CMD ["node","dist/src/main.js"]
