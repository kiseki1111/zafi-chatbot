# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS deps

WORKDIR /workspace

COPY package*.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/web/package.json apps/web/package.json

# Workaround for npm optional dependency bug in monorepo
RUN --mount=type=cache,target=/root/.npm \
    rm -f package-lock.json && npm install --legacy-peer-deps

#########################################################

FROM deps AS builder

WORKDIR /workspace

COPY . .

RUN npm run prisma:generate -w rbac-service
RUN npm run build -w rbac-service
RUN mkdir -p /workspace/apps/backend/node_modules

#########################################################

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Install necessary OS libraries for sharp and prisma + CA certificates
RUN apk add --no-cache openssl libc6-compat ca-certificates && update-ca-certificates

COPY --from=builder /workspace/node_modules ./node_modules
COPY --from=builder /workspace/apps/backend/node_modules ./apps/backend/node_modules
COPY --from=builder /workspace/apps/backend/dist ./dist
COPY --from=builder /workspace/apps/backend/package.json ./package.json
COPY --from=builder /workspace/apps/backend/src/core/prisma ./src/core/prisma

EXPOSE 3030

CMD ["sh", "-c", "npx prisma db push --schema=src/core/prisma/schema.prisma --accept-data-loss && (node dist/main.js || node dist/src/main.js)"]
