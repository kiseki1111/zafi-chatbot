# syntax=docker/dockerfile:1.7

############################
# Dependencies
############################
FROM node:22-alpine AS deps

WORKDIR /workspace

# hanya file yang mempengaruhi dependency
COPY package.json .
COPY package-lock.json .

COPY apps/backend/package.json apps/backend/package.json
COPY apps/web/package.json apps/web/package.json

RUN --mount=type=cache,target=/root/.npm \
    npm ci

############################
# Builder
############################
FROM deps AS builder

WORKDIR /workspace

# copy seluruh source
COPY . .

####################################################
# DEBUG
####################################################
RUN echo "===== FIND NEST ====="
RUN find /workspace -name "@nestjs" -type d

RUN echo "===== FIND PRISMA ====="
RUN find /workspace -name "@prisma" -type d

RUN echo "===== INSTALL STRATEGY ====="
RUN npm config get install-strategy

RUN echo "===== NPM ROOT ====="
RUN npm root -w rbac-service

####################################################
# BUILD
####################################################
RUN npm run prisma:generate -w rbac-service

RUN npm run build -w rbac-service

####################################################
# PRUNE
####################################################
RUN npm prune --omit=dev

############################
# Runner
############################
FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production

RUN apk add --no-cache openssl

COPY --from=builder /workspace/node_modules ./node_modules

COPY --from=builder /workspace/apps/backend/dist ./dist
COPY --from=builder /workspace/apps/backend/public ./public
COPY --from=builder /workspace/apps/backend/src/infrastructure/prisma ./src/infrastructure/prisma

EXPOSE 3030

CMD ["node","dist/src/main.js"]
