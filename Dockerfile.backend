# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS deps
WORKDIR /workspace

COPY package*.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/web/package.json apps/web/package.json

RUN --mount=type=cache,target=/root/.npm \
    npm ci

#########################################################

FROM deps AS builder
WORKDIR /workspace
COPY . .

# RUN npm run prisma:generate -w rbac-service
# RUN npm run build -w rbac-service

# Generate Client dan Build dilakukan di sini menggunakan script package.json root Anda
RUN npm run prisma:generate
RUN npm run build:backend

# Buang devDependencies untuk menghemat ruang produksi
RUN npm prune --production

#########################################################

FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
RUN apk add --no-cache openssl

# 1. Salin berkas manifes workspaces & node_modules produksi hasil filter builder
COPY --from=builder /workspace/package*.json ./
COPY --from=builder /workspace/node_modules ./node_modules

# 2. Salin folder biner .prisma yang sudah sukses di-generate dari STAGE BUILDER
COPY --from=builder /workspace/node_modules/.prisma ./node_modules/.prisma

# 3. Salin folder distribusi (dist) hasil dari build:backend monorepo yang berada di root dist/apps/backend
COPY --from=builder /workspace/apps/backend/dist ./dist
COPY --from=builder /workspace/apps/backend/public ./public
COPY --from=builder /workspace/apps/backend/package.json ./package.json
COPY --from=builder /workspace/apps/backend/src/infrastructure/prisma ./src/infrastructure/prisma

EXPOSE 3030

CMD ["node","dist/src/main.js"]
